# ============================================================
# IMPORTANT:
# Keep source, Gradle wrapper, F-Droid metadata and reproducible
# build configuration tracked.
#
# Examples that MUST remain tracked:
#   gradlew
#   gradlew.bat
#   gradle/wrapper/gradle-wrapper.jar
#   gradle/wrapper/gradle-wrapper.properties
#   metadata/
#   fastlane/
#   app/src/
#   settings.gradle*
#   build.gradle*
#   gradle.properties
# ============================================================
